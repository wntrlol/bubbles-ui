# Optional. Without it the app serves the fallback catalog in lib/mock-data.ts.
# v3 auth: an API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# JSON array of your licensed playback endpoints. Zenox ships with none, so
# until this is set the player shows its configuration empty state.
# Tokens: {id} {season} {episode} {title} {year}
# kind: "hls" for a direct .m3u8, "embed" for a sandboxed iframe.
# Embed origins listed here are added to the CSP frame-src allowlist automatically.
# STREAM_PROVIDERS=[{"id":"studio","label":"Studio CDN","kind":"hls","movie":"https://cdn.example.com/m/{id}/master.m3u8","tv":"https://cdn.example.com/t/{id}/{season}/{episode}/master.m3u8"}]
STREAM_PROVIDERS=

# Accounts, sync and notifications. Create a project at https://supabase.com,
# then run supabase/schema.sql in its SQL editor. Both values are safe to ship:
# the anon key is public by design and constrained by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Community link. The Discord control stays disabled until this is set.
NEXT_PUBLIC_DISCORD_URL=
